---
/**
 * /thermomix/<slug>/, one Thermomix recipe per page.
 *
 * Built for cooking from: ingredients in a panel you can tick off (sticky on
 * desktop), steps you can tap as done, and every Thermomix setting drawn as a
 * small machine-display chip. The schema.org Recipe JSON-LD in <head> is what
 * the Cookidoo push script reads. All copy lives in src/data/thermomix.ts.
 */
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { recipes, ingredientLine, splitStep, type Recipe } from '../../data/thermomix';

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

const { recipe } = Astro.props as { recipe: Recipe };
const url = new URL(`/thermomix/${recipe.slug}/`, Astro.site ?? 'https://michaelcastelein.com').href;
const iso = (min: number) => `PT${min}M`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.name,
  description: recipe.description,
  url,
  author: { '@type': 'Person', name: site.name, url: 'https://michaelcastelein.com' },
  datePublished: recipe.published,
  image: ['https://michaelcastelein.com/img/michael.jpeg'],
  prepTime: iso(recipe.prepMin),
  cookTime: iso(recipe.cookMin),
  totalTime: iso(recipe.totalMin),
  recipeYield: [String(recipe.servings), recipe.yield],
  recipeCategory: recipe.category,
  recipeCuisine: recipe.cuisine,
  keywords: ['Thermomix', ...recipe.keywords].join(', '),
  tool: [{ '@type': 'HowToTool', name: 'Thermomix' }],
  recipeIngredient: recipe.ingredients.map(ingredientLine),
  recipeInstructions: recipe.steps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text,
    url: `${url}#step-${i + 1}`,
  })),
};

const steps = recipe.steps.map(splitStep);
const machineSteps = steps.filter((s) => s.some((p) => p.kind === 'setting')).length;

/** The machine program: every setting, with the verb right before it ("chop", "mill"). */
const program = steps.flatMap((parts, n) =>
  parts.flatMap((p, k) => {
    if (p.kind !== 'setting') return [];
    const before = parts[k - 1];
    const verb = before?.kind === 'text' ? before.text.trim().split(/\s+/).pop() ?? '' : '';
    return [{ step: n + 1, verb: verb.charAt(0).toUpperCase() + verb.slice(1), p }];
  }),
);

const stats = [
  { k: 'Makes', v: recipe.yield },
  { k: 'Ready in', v: `${recipe.totalMin} min` },
  ...(recipe.oven ? [{ k: 'Oven', v: recipe.oven }] : []),
  { k: 'On the Thermomix', v: `${machineSteps} steps` },
];
---

<Base title={`${recipe.name} · Thermomix · ${site.name}`} description={recipe.description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="rx" style={`--rx-deep:${recipe.color.deep};--rx-light:${recipe.color.light};`}>
    <a class="rx__back" href="/thermomix/">All Thermomix recipes</a>

    <header class="rx__head">
      <div class="rx__intro">
      <h1 class="rx__title">{recipe.name}</h1>
      <p class="rx__tag">{recipe.tagline}</p>
      <dl class="rx__stats">
        {stats.map((s) => (
          <div>
            <dt>{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))}
      </dl>
      </div>

      {program.length > 0 && (
        <div class="rx__prog" aria-label="Thermomix settings at a glance">
          <p class="rx__prog-h">Thermomix program</p>
          <ol>
            {program.map(({ step, verb, p }) => (
              <li>
                <a href={`#step-${step}`}>
                  <span class="rx__prog-n">{step}</span>
                  <span class="rx__prog-v">{verb}</span>
                  <span class="tm tm--inv" aria-label={p.raw}>
                    <span class="tm__seg">{p.time}</span>
                    {p.temp && <span class="tm__seg">{p.temp}</span>}
                    {p.reverse && <span class="tm__seg tm__rev" title="Reverse">↺</span>}
                    <span class="tm__seg tm__speed">speed {p.speed}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
    </header>

    <div class="rx__body">
      <aside class="rx__ing" aria-labelledby="ing-h">
        <div class="rx__ing-head">
          <h2 id="ing-h">Ingredients</h2>
          <p>Tap to tick off</p>
        </div>
        <ul>
          {recipe.ingredients.map((i) => (
            <li>
              <button type="button" class="rx__i" aria-pressed="false">
                <span class="rx__q">{i.qty}</span>
                <span class="rx__n">
                  {i.item}
                  {i.note && <small>{i.note}</small>}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </aside>

      <div class="rx__method">
        <h2>Method</h2>
        <ol class="rx__steps">
          {steps.map((parts, n) => (
            <li id={`step-${n + 1}`}>
              <button type="button" class="rx__s" aria-pressed="false">
                <span class="rx__num">{n + 1}</span>
                <span class="rx__txt">
                  {parts.map((p) =>
                    p.kind === 'text' ? (
                      p.text
                    ) : (
                      <span class="tm" aria-label={p.raw} title={p.raw}>
                        <span class="tm__seg">{p.time}</span>
                        {p.temp && <span class="tm__seg">{p.temp}</span>}
                        {p.reverse && (
                          <span class="tm__seg tm__rev" title="Reverse">
                            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                              <path d="M3.5 8a4.5 4.5 0 1 0 1.3-3.2M3.5 2.5v2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        )}
                        <span class="tm__seg tm__speed">speed {p.speed}</span>
                      </span>
                    ),
                  )}
                </span>
              </button>
            </li>
          ))}
        </ol>

        <h2>Good to know</h2>
        <ul class="rx__tips">
          {recipe.tips.map((t) => <li>{t}</li>)}
        </ul>

        <p class="rx__src">
          Built from the best rated versions online:{' '}
          {recipe.basedOn.map((b, i) => (
            <>
              <a href={b.url} rel="noopener" target="_blank">{b.name}</a> ({b.note}){i < recipe.basedOn.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </div>
    </div>
  </article>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.rx__i, .rx__s').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true'));
      });
    });
  </script>
</Base>
