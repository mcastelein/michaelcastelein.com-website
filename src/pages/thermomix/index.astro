---
/**
 * /thermomix/, the list of Thermomix recipes. Each row takes the recipe's own
 * colors, so the list looks like the pages it links to.
 */
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { recipes, splitStep } from '../../data/thermomix';

const rows = recipes.map((r) => ({
  ...r,
  machineSteps: r.steps.filter((s) => splitStep(s).some((p) => p.kind === 'setting')).length,
}));
---

<Base
  title={`Thermomix recipes · ${site.name}`}
  description="Recipes I cook at home, written for the Thermomix, with every machine setting in the steps."
>
  <section class="rx rx--list">
    <a class="rx__back" href="/">Home</a>
    <header class="rx__head">
      <h1 class="rx__title">Thermomix recipes</h1>
      <p class="rx__tag">What I cook at home. Every step has its machine setting, so you can follow along at the bowl.</p>
    </header>

    <ul class="rx__list">
      {rows.map((r) => (
        <li style={`--rx-deep:${r.color.deep};--rx-light:${r.color.light};`}>
          <a href={`/thermomix/${r.slug}/`}>
            <span class="rx__list-name">{r.name}</span>
            <span class="rx__list-tag">{r.tagline}</span>
            <span class="rx__list-meta">
              {r.yield}, {r.totalMin} min, {r.ingredients.length} ingredients, {r.machineSteps} Thermomix steps
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
