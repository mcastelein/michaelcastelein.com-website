---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Globe from '../components/Globe.astro';
import Photo from '../components/Photo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { hasPhotos, photoAt } from '../lib/photos';
import {
  site, hero, services, now, ventures, projects,
  bases, baseColors, path, languages, play, coffee,
} from '../data/site';

const today = new Date();
const currentBase = bases.find((b) => b.months.includes(today.getMonth() + 1)) ?? bases[0];

/* The hero portrait. Falls back to nothing if the folder is empty, so the
   layout never leaves a hole. */
const portrait = photoAt('me', 0);

/* Photo-bearing blocks only render once there are photos to put in them. */
/* The band is designed as a triptych. Until all three slots are filled it would
   leave holes, so a partly-filled band collapses to a single centred portrait.
   The 'me' slot starts at index 2 because index 0 is now the hero portrait. */
const bandSlots: Array<[string, number]> = [['me', 2], ['chaozhou', 0], ['kunming', 0]];
const bandFilled = bandSlots.filter(([c, i]) => photoAt(c, i)).length;
const bandMode = bandFilled === bandSlots.length ? 'full' : bandFilled > 0 ? 'solo' : 'none';

const showMosaic = hasPhotos(
  ['chaozhou', 3], ['netherlands', 0], ['play', 0],
  ['kunming', 3], ['usa', 0], ['me', 1]
);
const showPlayPhotos = hasPhotos(['play', 1], ['play', 2]);
const homeHasPhotos = (id: string) => hasPhotos([id, 1], [id, 2]);

/* Only the three most interesting projects on the home page. The full list
   lives at /projects. */
const featured = projects.slice(0, 3);

const pageTitle = `${site.name} · Data & AI consultant, AI adoption training`;
---

<Base title={pageTitle} home={true}>
  <!-- ── Hero ───────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__text">
      {portrait ? (
        <div class="hero__portrait">
          <Image
            src={portrait.src}
            alt={site.name}
            widths={[128, 256]}
            sizes="64px"
            loading="eager"
          />
          <span class="hero__portrait-txt">
            <strong>{site.name}</strong>
            Dutch-American · Data &amp; AI
          </span>
        </div>
      ) : (
        <p class="eyebrow">Dutch-American · Data &amp; AI · {site.domain}</p>
      )}

      <h1 class="hero__h1">
        {hero.lines[0]}<br />
        {hero.lines[1]}<br />
        <em>{hero.lines[2]}</em>
      </h1>
      <p class="lede">{hero.lede}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={site.contact} data-track="coffee" data-track-location="hero">
          Get in touch
        </a>
        <a class="btn" href="/projects/">See the projects</a>
      </div>
      <p class="hero__now">
        <span class="pip" style={`--c:${baseColors[currentBase.id].accent}`}></span>
        Right now: {currentBase.country}, {currentBase.utc}
      </p>
    </div>

    <div class="hero__globe">
      <Globe />
      <p class="hero__globe-cap">Drag to spin. The arcs are the real route.</p>
    </div>
  </section>

  <!-- ── What I do: the two offers ──────────────────────────────────────── -->
  <section class="section" id="work">
    <div class="section__head">
      <p class="rubric">What I do</p>
      <h2>Two halves of the same job.</h2>
      <p class="section__sub">
        One is building the data a business runs on. The other is getting the
        people in that business to use the tools already sitting in front of them.
      </p>
    </div>

    <div class="svc">
      {services.map((s, i) => (
        <article class="svc__item">
          <p class="svc__index"><span>{String(i + 1).padStart(2, '0')}</span> / {s.status}</p>
          <h3 class="svc__name">{s.name}</h3>
          <p class="svc__body">{s.body}</p>
          <ul class="svc__list">
            {s.includes.map((d) => <li>{d}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="svc__foot">
      <a class="btn btn--solid" href={site.contact} data-track="coffee" data-track-location="services">
        Talk about a project
      </a>
    </p>
  </section>

  <!-- ── Projects ───────────────────────────────────────────────────────── -->
  <section class="section" id="projects">
    <div class="section__head">
      <p class="rubric">Projects</p>
      <h2>What I have built.</h2>
      <p class="section__sub">
        Products, and tools that started as a problem I had. Some are live in the
        browser, some run on my own machine.
      </p>
    </div>

    <div class="projects">
      {featured.map((pr) => <ProjectCard project={pr} level={3} />)}
    </div>

    <p class="svc__foot">
      <a class="btn" href="/projects/">All projects</a>
    </p>
  </section>

  <!-- ── Now ────────────────────────────────────────────────────────────── -->
  <section class="section section--split" id="now">
    <div class="section__head">
      <p class="rubric">Now</p>
      <h2>What's happening.</h2>
      <p class="section__sub">Updated {now.updated}</p>
    </div>
    <ul class="ruled">
      {now.lines.map((l) => <li>{l}</li>)}
    </ul>
  </section>

  <!-- ── Building ───────────────────────────────────────────────────────── -->
  <section class="section" id="building">
    <div class="section__head">
      <p class="rubric">Building</p>
      <h2>The rest of it.</h2>
      <p class="section__sub">{ventures.intro}</p>
    </div>
    <div class="cards">
      {ventures.strands.map((s) => (
        <article class="card">
          <header class="card__head">
            <h3>{s.name}</h3>
            <span class="tag">{s.status}</span>
          </header>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Where: the loop, demoted to a section ──────────────────────────── -->
  <section class="section" id="where">
    <div class="section__head">
      <p class="rubric">Where</p>
      <h2>I do all of it from four homes.</h2>
      <p class="section__sub">
        The same route, in the same order, every year: Chaozhou, Kunming, the
        Netherlands, the United States. Chaozhou and Kunming are both in China
        and share almost nothing. Different food, climate and language, with a
        thousand kilometres between them.
      </p>
    </div>

    {bandMode !== 'none' && (
      <div class:list={['band', `band--${bandMode}`]} aria-label="Photographs">
        <Photo category="me" index={2} hint="A portrait that isn't a headshot" ratio="4 / 5" class="band__a" />
        <Photo category="chaozhou" index={0} hint="Chaozhou street life, wide" ratio="3 / 2" class="band__b" />
        <Photo category="kunming" index={0} hint="Kunming, the plateau or the city" ratio="4 / 5" class="band__c" />
      </div>
    )}

    {bases.map((b, i) => (
      <article
        class:list={['home', { 'home--flip': i % 2 === 1, 'home--solo': !homeHasPhotos(b.id) }]}
        style={`--c:${baseColors[b.id].accent}`}
      >
        {homeHasPhotos(b.id) && (
          <div class="home__photos">
            <Photo category={b.id} index={1} hint={`${b.city}, the establishing shot`} ratio="3 / 4" />
            <Photo category={b.id} index={2} hint={`${b.city}, a detail close up`} ratio="1 / 1" class="home__photo2" />
          </div>
        )}

        <div class="home__body">
          <p class="home__index">
            <span>{String(i + 1).padStart(2, '0')}</span> / {b.role}
          </p>
          <h3 class="home__city">
            <span>{b.city}</span>
            {b.cityLocal && <em lang="zh-Hans">{b.cityLocal}</em>}
          </h3>
          <p class="home__when">{b.monthLabel} · {b.country} · {b.lat.toFixed(1)}°, {b.lon.toFixed(1)}°</p>
          <p class="home__headline">{b.headline}</p>
          <p class="home__prose">{b.body}</p>
          <ul class="home__list">
            {b.doing.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </article>
    ))}

    {showMosaic && (
      <div class="mosaic">
        <Photo category="chaozhou" index={3} hint="Family traditions, Chaozhou" ratio="1 / 1" />
        <Photo category="netherlands" index={0} hint="Dutch water, bikes, or summer" ratio="1 / 1" />
        <Photo category="play" index={0} hint="Table tennis or badminton" ratio="1 / 1" />
        <Photo category="kunming" index={3} hint="Kunming, everyday" ratio="1 / 1" />
        <Photo category="usa" index={0} hint="The US stretch" ratio="1 / 1" />
        <Photo category="me" index={1} hint="You, mid-something" ratio="1 / 1" />
      </div>
    )}
  </section>

  <!-- ── Path ───────────────────────────────────────────────────────────── -->
  <section class="section section--split" id="path">
    <div class="section__head">
      <p class="rubric">Before this</p>
      <h2>Aerospace to analytics.</h2>
    </div>
    <ol class="log">
      {path.map((pp) => (
        <li>
          <span class="log__what">{pp.what}</span>
          <span class="log__where">{pp.where}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Play ───────────────────────────────────────────────────────────── -->
  <section class="section" id="play">
    <div class="section__head">
      <p class="rubric">Off the clock</p>
      <h2>Rackets, distance, spreadsheets.</h2>
    </div>
    <div class:list={['play', { 'play--nophotos': !showPlayPhotos }]}>
      {showPlayPhotos && (
        <div class="play__photos">
          <Photo category="play" index={1} hint="Mid-rally, or a team photo" ratio="3 / 2" />
          <Photo category="play" index={2} hint="Running or training" ratio="3 / 2" />
        </div>
      )}
      <div class="play__cards">
        {play.map((pl) => (
          <article class="mini">
            <h3>{pl.name}</h3>
            <p>{pl.body}</p>
          </article>
        ))}
      </div>
      <div class="langs">
        <p class="rubric">Languages</p>
        <ul>
          {languages.map((l) => (
            <li>
              <span>{l.name}</span>
              <span class="langs__dot" aria-hidden="true"></span>
              <span class="langs__lvl">{l.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Coffee ─────────────────────────────────────────────────────────── -->
  <section class="coffee" id="coffee">
    <div class="coffee__inner">
      <p class="rubric rubric--light">Get in touch</p>
      <h2>{coffee.headline}</h2>
      <p class="coffee__body">{coffee.body}</p>
      <a class="btn btn--light btn--lg" href={site.contact} data-track="coffee" data-track-location="footer-cta">
        {site.contactLabel}
      </a>
      <p class="coffee__fine">{coffee.fineprint}</p>
    </div>
  </section>
</Base>
