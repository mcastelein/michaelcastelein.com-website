---
/**
 * Shared page shell: head, meridian rules, masthead, footer.
 *
 * Every page uses this so the chrome and the styles cannot drift. All of the
 * CSS lives in src/styles/site.css as a global sheet, because Astro's scoped
 * <style> would otherwise stop at the file that declared it.
 */
import '../styles/base.css';
import '../styles/site.css';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Analytics from '../components/Analytics.astro';
import { site, liveSocials } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Home renders anchor links; other pages link back to the sections. */
  home?: boolean;
}

const { title, description = site.short, home = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://michaelcastelein.com').href;
const p = (hash: string) => (home ? hash : `/${hash}`);
const socials = liveSocials();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://michaelcastelein.com/img/michael.jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <Analytics />
  </head>
  <body data-design="b1-meridian">
    <!-- The structural signature: meridian lines ruled down the page, the flat
         version of the longitude lines on the globe. -->
    <div class="meridians" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>

    <header class="mast">
      <a class="mast__id" href={home ? '#top' : '/'}>
        <span class="mast__dot"></span>{site.name}
      </a>
      <nav class="mast__nav">
        <a href={p('#work')}>Work</a>
        <a href="/projects/">Projects</a>
        <a href={p('#now')}>Now</a>
        <a href={p('#where')}>Where</a>
        <a href={p('#coffee')} class="mast__cta" data-track="coffee" data-track-location="nav">Coffee</a>
      </nav>
    </header>

    <main id="top">
      <slot />

      <footer class="foot">
        <span>{site.name}</span>
        <ul class="foot__links">
          {socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank">{s.label}</a>
            </li>
          ))}
          <li><a href="/projects/">Projects</a></li>
        </ul>
      </footer>
    </main>
  </body>
</html>
