---
/**
 * Full-screen motion intro that plays over the home page on the first visit of
 * a browser session, then fades out to reveal the site.
 *
 * The video is built in Remotion (higgsfield-testing/motion-intro) and lives in
 * public/intro/. It is skipped for reduced-motion visitors and on repeat visits
 * in the same session, so it never gets in the way twice.
 */
---

<div class="intro" id="intro" aria-label="Intro video">
  <video
    class="intro__video"
    src="/intro/intro.mp4"
    poster="/intro/poster.jpg"
    muted
    playsinline
    autoplay
    preload="auto"
  ></video>
  <button class="intro__skip" type="button" data-track="intro-skip">Skip intro</button>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('intro');
    if (!el) return;
    var seen = false;
    try { seen = sessionStorage.getItem('mc-intro') === '1'; } catch (e) {}
    var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || calm) { el.remove(); return; }

    document.documentElement.classList.add('intro-on');
    var video = el.querySelector('video');
    var done = false;
    function close() {
      if (done) return;
      done = true;
      try { sessionStorage.setItem('mc-intro', '1'); } catch (e) {}
      el.classList.add('intro--out');
      document.documentElement.classList.remove('intro-on');
      setTimeout(function () { el.remove(); }, 700);
    }
    video.addEventListener('ended', close);
    video.addEventListener('error', close);
    el.querySelector('.intro__skip').addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    // If autoplay is blocked, do not leave the visitor stuck behind a still frame.
    var p = video.play();
    if (p && p.catch) p.catch(close);
  })();
</script>

<style is:global>
  html.intro-on { overflow: hidden; }
  .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #06060b;
    display: grid;
    place-items: center;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .intro--out { opacity: 0; transform: scale(1.04); pointer-events: none; }
  /* contain, so no screen shape crops the text; the page background matches the video edges. */
  .intro__video { width: 100%; height: 100%; object-fit: contain; }
  .intro__skip {
    position: absolute;
    right: 16px;
    bottom: 16px;
    font: 500 13px/1 var(--mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f4f1ea;
    background: rgba(6, 6, 11, 0.6);
    border: 1px solid rgba(244, 241, 234, 0.35);
    border-radius: 999px;
    padding: 10px 16px;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }
  .intro__skip:hover { border-color: #3cf0ff; color: #3cf0ff; }
</style>
