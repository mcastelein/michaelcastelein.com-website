---
import { bases, baseColors } from '../data/site';

/**
 * A 3D globe of the loop: four markers, great-circle arcs joining them in the
 * order Michael actually travels, drawn on a shaded sphere with a graticule.
 *
 * Deliberate choices:
 *  - Three.js is imported dynamically once the globe scrolls into view, so it
 *    never blocks first paint and costs nothing to visitors who don't reach it.
 *  - Colours come from CSS custom properties, so each art direction restyles it
 *    without touching this file.
 *  - Rendering stops when the globe leaves the viewport, and auto-rotation never
 *    starts if the visitor asked for reduced motion.
 *  - There's no wheel handler: hijacking scroll on a globe is hostile.
 */
interface Props {
  class?: string;
  /** Show projected HTML labels next to each marker. */
  labels?: boolean;
  /** Arc bulge; higher looks more like a flight path. */
  lift?: number;
}

const { class: className = '', labels = true, lift = 0.15 } = Astro.props;

const points = bases.map((b) => ({
  id: b.id,
  label: b.city.startsWith('[[') ? b.country : b.city,
  lat: b.lat,
  lon: b.lon,
  color: baseColors[b.id].accent,
}));
---

<div
  class:list={['globe', className]}
  data-globe
  data-points={JSON.stringify(points)}
  data-lift={lift}
  data-labels={labels ? '1' : '0'}
>
  <canvas class="globe__canvas"></canvas>
  {labels && (
    <div class="globe__labels" aria-hidden="true">
      {points.map((p) => (
        <span class="globe__label" data-label-for={p.id} style={`--c:${p.color}`}>
          <i></i>{p.label}
        </span>
      ))}
    </div>
  )}
  <p class="globe__sr">
    A globe showing the annual route between {points.map((p) => p.label).join(', ')}.
  </p>
</div>

<script>
  type Pt = { id: string; label: string; lat: number; lon: number; color: string };

  const setup = async (host: HTMLElement) => {
    const THREE = await import('three');
    const canvas = host.querySelector('canvas') as HTMLCanvasElement;
    const pts: Pt[] = JSON.parse(host.dataset.points || '[]');
    const lift = parseFloat(host.dataset.lift || '0.28');
    const wantLabels = host.dataset.labels === '1';

    // Theme from CSS so each design controls the look.
    const css = (name: string, fallback: string) =>
      getComputedStyle(host).getPropertyValue(name).trim() || fallback;
    const cSphere = css('--globe-sphere', '#ffffff');
    const cLine = css('--globe-line', '#9dc0ef');
    const cLineFaint = css('--globe-line-faint', '#cddff6');
    const cArc = css('--globe-arc', '#1f6feb');
    const cGlow = css('--globe-glow', '#dce9fb');

    const R = 1;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    // Far enough back that a lifted arc over a 110° hop still stays in frame.
    camera.position.set(0, 0.55, 4.35);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    const world = new THREE.Group();
    // Tilt so the northern hemisphere — where all four homes are — faces the viewer.
    world.rotation.x = 0.32;
    scene.add(world);

    // ── Sphere ────────────────────────────────────────────────────────────────
    /* Unlit on purpose. Three's physical lighting turns a white Lambert sphere
       grey, and grey is the one colour this brief doesn't want. A flat sphere
       reads as a drafting or porcelain globe, and the depth comes from the
       graticule's perspective, the lifted arcs, and the rim glow instead. */
    const globeMesh = new THREE.Mesh(
      new THREE.SphereGeometry(R, 64, 48),
      new THREE.MeshBasicMaterial({ color: new THREE.Color(cSphere) })
    );
    world.add(globeMesh);

    // A soft halo, so a white globe still reads against a white page.
    const halo = new THREE.Mesh(
      new THREE.SphereGeometry(R * 1.045, 48, 32),
      new THREE.MeshBasicMaterial({
        color: new THREE.Color(cGlow),
        transparent: true,
        opacity: 0.5,
        side: THREE.BackSide,
      })
    );
    world.add(halo);

    // ── Graticule ─────────────────────────────────────────────────────────────
    const toVec = (lat: number, lon: number, r = R) => {
      const phi = ((90 - lat) * Math.PI) / 180;
      const theta = ((lon + 180) * Math.PI) / 180;
      return new THREE.Vector3(
        -r * Math.sin(phi) * Math.cos(theta),
        r * Math.cos(phi),
        r * Math.sin(phi) * Math.sin(theta)
      );
    };

    const gridMat = new THREE.LineBasicMaterial({
      color: new THREE.Color(cLine),
      transparent: true,
      opacity: 0.8,
    });
    const gridMatFaint = new THREE.LineBasicMaterial({
      color: new THREE.Color(cLineFaint),
      transparent: true,
      opacity: 0.9,
    });

    for (const lat of [-60, -30, 0, 30, 60]) {
      const pts3: THREE.Vector3[] = [];
      for (let lon = -180; lon <= 180; lon += 3) pts3.push(toVec(lat, lon, R * 1.002));
      world.add(
        new THREE.Line(
          new THREE.BufferGeometry().setFromPoints(pts3),
          lat === 0 ? gridMat : gridMatFaint
        )
      );
    }
    /* Meridians get the stronger colour. They're the lines that describe the
       sphere's curvature, and on a white globe against a white page the faint
       colour left the whole thing barely visible. */
    for (let lon = -180; lon < 180; lon += 30) {
      const pts3: THREE.Vector3[] = [];
      for (let lat = -90; lat <= 90; lat += 3) pts3.push(toVec(lat, lon, R * 1.002));
      world.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts3), gridMat));
    }

    // ── Arcs: the loop, in travel order, closing back on itself ───────────────
    const arcs: THREE.Mesh[] = [];
    for (let i = 0; i < pts.length; i++) {
      const a = toVec(pts[i].lat, pts[i].lon).normalize();
      const b = toVec(pts[(i + 1) % pts.length].lat, pts[(i + 1) % pts.length].lon).normalize();
      const curvePts: THREE.Vector3[] = [];
      const steps = 72;
      for (let s = 0; s <= steps; s++) {
        const t = s / steps;
        // Spherical interpolation, lifted in the middle like a flight path.
        const v = a.clone().lerp(b, t).normalize();
        v.multiplyScalar(R * (1 + lift * Math.sin(Math.PI * t)));
        curvePts.push(v);
      }
      const tube = new THREE.Mesh(
        new THREE.TubeGeometry(new THREE.CatmullRomCurve3(curvePts), 90, 0.0075, 8, false),
        new THREE.MeshBasicMaterial({ color: new THREE.Color(cArc) })
      );
      // Draw-in animation: reveal each arc in sequence.
      tube.geometry.setDrawRange(0, 0);
      arcs.push(tube);
      world.add(tube);
    }

    // ── Markers ───────────────────────────────────────────────────────────────
    const markers: { mesh: THREE.Mesh; pt: Pt; pos: THREE.Vector3 }[] = [];
    for (const p of pts) {
      const pos = toVec(p.lat, p.lon, R * 1.012);
      const mesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.026, 20, 16),
        new THREE.MeshBasicMaterial({ color: new THREE.Color(p.color) })
      );
      mesh.position.copy(pos);
      mesh.userData.id = p.id;
      world.add(mesh);

      const ring = new THREE.Mesh(
        new THREE.RingGeometry(0.036, 0.05, 28),
        new THREE.MeshBasicMaterial({
          color: new THREE.Color(p.color),
          transparent: true,
          opacity: 0.45,
          side: THREE.DoubleSide,
        })
      );
      ring.position.copy(pos);
      ring.lookAt(0, 0, 0);
      world.add(ring);

      markers.push({ mesh, pt: p, pos, idx: markers.length });
    }

    // ── Sizing ────────────────────────────────────────────────────────────────
    const resize = () => {
      const w = host.clientWidth;
      const h = host.clientHeight || w;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    new ResizeObserver(resize).observe(host);

    // ── Drag to spin ──────────────────────────────────────────────────────────
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let spin = 0.0016;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) spin = 0;

    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
      canvas.style.cursor = 'grabbing';
    });
    canvas.addEventListener('pointerup', (e) => {
      dragging = false;
      canvas.releasePointerCapture(e.pointerId);
      canvas.style.cursor = 'grab';
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      world.rotation.y += (e.clientX - lastX) * 0.006;
      world.rotation.x = Math.max(-0.9, Math.min(1.1, world.rotation.x + (e.clientY - lastY) * 0.004));
      lastX = e.clientX;
      lastY = e.clientY;
    });

    // ── Marker hover + click ──────────────────────────────────────────────────
    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let hovered: string | null = null;

    const pick = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      ndc.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      ndc.y = -((e.clientY - r.top) / r.height) * 2 + 1;
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObjects(markers.map((m) => m.mesh))[0];
      return hit ? (hit.object.userData.id as string) : null;
    };

    canvas.addEventListener('pointermove', (e) => {
      if (dragging) return;
      const id = pick(e);
      if (id !== hovered) {
        hovered = id;
        canvas.style.cursor = id ? 'pointer' : 'grab';
        host.querySelectorAll('.globe__label').forEach((l) => {
          l.classList.toggle('is-hot', (l as HTMLElement).dataset.labelFor === id);
        });
      }
    });

    canvas.addEventListener('click', (e) => {
      const id = pick(e);
      if (!id) return;
      // Let the page react (and let analytics count it).
      host.dispatchEvent(new CustomEvent('globe:select', { detail: { base: id }, bubbles: true }));
      document.dispatchEvent(new CustomEvent('globe:interact', { detail: { base: id } }));
    });

    // ── Label projection ──────────────────────────────────────────────────────
    const labelEls = new Map<string, HTMLElement>();
    if (wantLabels) {
      host.querySelectorAll<HTMLElement>('.globe__label').forEach((el) => {
        labelEls.set(el.dataset.labelFor!, el);
      });
    }

    const placeLabels = () => {
      if (!labelEls.size) return;
      const w = host.clientWidth;
      const h = host.clientHeight;
      for (const m of markers) {
        const el = labelEls.get(m.pt.id);
        if (!el) continue;

        const world3 = m.pos.clone().applyMatrix4(world.matrixWorld);

        /* A marker is visible only if its surface normal points back toward the
           camera. Comparing against the camera's own direction (rather than the
           direction from the marker to the camera) let limb markers through, so
           labels appeared with no dot under them. */
        const toCam = camera.position.clone().sub(world3).normalize();
        const facing = world3.clone().normalize().dot(toCam) > 0.08;
        el.style.opacity = facing ? '1' : '0';

        const v = world3.clone().project(camera);
        // Nudge alternate labels apart — Chaozhou and Kunming sit close together.
        const dy = m.idx % 2 === 0 ? -14 : 14;
        el.style.transform =
          `translate(-50%,-50%) translate(${((v.x + 1) / 2) * w}px, ${((-v.y + 1) / 2) * h + dy}px)`;
      }
    };

    // ── Loop, paused when off-screen ──────────────────────────────────────────
    let running = false;
    let t0 = performance.now();
    let revealed = 0;

    const frame = (now: number) => {
      if (!running) return;
      const dt = now - t0;
      t0 = now;

      if (!dragging) world.rotation.y += spin * (dt / 16.67);

      // Reveal arcs one after another on first view.
      if (revealed < arcs.length) {
        const arc = arcs[revealed];
        const total = arc.geometry.index ? arc.geometry.index.count : 0;
        const step = Math.max(60, total / 45);
        const next = Math.min(total, arc.geometry.drawRange.count + step);
        arc.geometry.setDrawRange(0, next);
        if (next >= total) revealed++;
      }

      world.updateMatrixWorld();
      placeLabels();
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    };

    const vis = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !running) {
          running = true;
          t0 = performance.now();
          if (reduce) arcs.forEach((a) => a.geometry.setDrawRange(0, Infinity));
          requestAnimationFrame(frame);
        } else if (!entry.isIntersecting) {
          running = false;
        }
      },
      { threshold: 0.01 }
    );
    vis.observe(host);
  };

  // Only load Three.js once a globe is close to being seen.
  document.querySelectorAll<HTMLElement>('[data-globe]').forEach((host) => {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        setup(host).catch(() => {
          // If WebGL or the import fails, the descriptive text stays. No broken box.
          host.dataset.globeFailed = '1';
        });
      },
      { rootMargin: '250px' }
    );
    io.observe(host);
  });
</script>

<style>
  .globe {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    touch-action: pan-y; /* let people scroll past on touch without trapping them */
  }
  .globe__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  .globe__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .globe__label {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px 3px 6px;
    border-radius: 999px;
    white-space: nowrap;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--globe-label-ink, #10305f);
    background: var(--globe-label-bg, rgba(255, 255, 255, 0.9));
    box-shadow: 0 1px 6px rgba(16, 48, 95, 0.16);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .globe__label i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .globe__label.is-hot {
    background: var(--c);
    color: #fff;
  }
  .globe__label.is-hot i { background: #fff; }

  .globe__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* If WebGL isn't available, show the description instead of an empty square. */
  .globe[data-globe-failed='1'] .globe__sr {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    clip: auto;
    white-space: normal;
    font-size: 13px;
    opacity: 0.7;
  }
</style>
