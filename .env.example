# Copy to .env and fill in. Values prefixed PUBLIC_ are visible in the browser
# (that's expected for analytics keys — they're write-only project keys).

# PostHog project API key. Create a project at https://eu.posthog.com,
# then Settings -> Project -> Project API Key (starts with "phc_").
# Leave blank to disable analytics entirely — the site works fine without it.
PUBLIC_POSTHOG_KEY=
